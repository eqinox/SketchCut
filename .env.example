# Copy this file to `.env.local` (Vite чете `.env.local`, не `.env.example`).
# Web ключовете по-долу са публични (Firebase apiKey). Admin ключовете — НЕ.

# ── Firebase Web (браузър) ──────────────────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=AIzaSyBPwz_S8tgeO9fmdJe0a5tmVOyXGE1WVl8
VITE_FIREBASE_AUTH_DOMAIN=next2-app-5a30b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=next2-app-5a30b
VITE_FIREBASE_STORAGE_BUCKET=next2-app-5a30b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=39567492705
VITE_FIREBASE_APP_ID=1:39567492705:web:20e230f6c4925795a14c20

VITE_ADMIN_EMAIL=vasil.nikolov123@gmail.com

# ── Firebase Admin (само npm run dev / сървър) ──────────────────────────────
# Генерирай JSON: Firebase Console → ⚙ Project settings → Service accounts
# → Generate new private key. После препиши полетата 1:1:
#
#   JSON private_key_id  →  FIREBASE_PRIVATE_KEY_ID
#   JSON private_key     →  FIREBASE_PRIVATE_KEY   (цялото, в кавички, с \n)
#   JSON client_email    →  FIREBASE_CLIENT_EMAIL
#   JSON client_id       →  FIREBASE_CLIENT_ID
#
# Пример как изглежда private_key в JSON-а (реалният е ~1600 символа):
#   "private_key": "-----BEGIN PRIVATE KEY-----\nMIIE...много редове...\n-----END PRIVATE KEY-----\n"
# Копирай цялата стойност заедно с BEGIN/END и \n. Не съкращавай.
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

ADMIN_EMAIL=vasil.nikolov123@gmail.com
