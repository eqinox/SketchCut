rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read/write only their own projects
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

    match /settings/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }

  // A room picture sent as a link. Anyone with the id can open it. Listing every link is closed.
  match /shares/{shareId} {
    allow get: if true;
    allow list: if false;
    allow create: if request.auth != null
      && request.resource.data.ownerId == request.auth.uid
      && request.resource.data.room is map
      && request.resource.data.cabinets is list
      && request.resource.data.finishes is list
      && request.resource.data.createdAt is number;
    allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
  }
}
}
